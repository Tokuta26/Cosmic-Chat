   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #F5F0FF;
}

QLabel {
    color: #493271;
    font-size: 14px;
    font-weight: bold;
}

QLabel#titleLabel {
    color: #493271;
    font-size: 25px;
    font-weight: bold;
    padding: 12px;
}

QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F0E9FC;
    color: #493271;
    gridline-color: #DDD0F4;
    border: 1px solid #D1BDED;
    border-radius: 10px;
    selection-background-color: #C5B5E9;
    selection-color: #352252;
    font-size: 13px;
}

QTableView::item:selected {
    background-color: #C5B5E9;
    color: #352252;
}

QHeaderView::section {
    background-color: #DED2F4;
    color: #493271;
    padding: 8px;
    border: none;
    border-right: 1px solid #CBB9E9;
    font-weight: bold;
}

QPushButton {
    background-color: #C5B5E9;
    color: #493271;
    border: 1px solid #B7A2DF;
    border-radius: 9px;
    padding: 9px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #B39DDF;
}

QPushButton:pressed {
    background-color: #9F85D0;
}

QPushButton#banButton {
    background-color: #E8BED1;
    color: #64344E;
    border-color: #D8A3BB;
}

QPushButton#banButton:hover {
    background-color: #DDA9C0;
}

QLabel#usersLabel,
QLabel#messagesLabel {
    color: #493271;
    font-size: 16px;
    font-weight: bold;
}

QMessageBox {
    background-color: #F5F0FF;
}

QMessageBox QLabel {
    color: #3D2865;
    background-color: transparent;
    font-size: 14px;
    font-weight: bold;
}

QMessageBox QPushButton {
    background-color: #C5B5E9;
    color: #3D2865;
}
</string>
